<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BetterBeads</AssemblyName>
    <RootNamespace>BetterBeads</RootNamespace>
    <LiteBuild Condition="'$(LiteBuild)' == ''">true</LiteBuild>
    <Version Condition="'$(LiteBuild)' == 'true'">1.1.0</Version>
    <Version Condition="'$(LiteBuild)' != 'true'">0.16.4</Version>
    <GamePath Condition="'$(GamePath)' == ''">D:\steam\steamapps\common\Stardew Valley</GamePath>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LiteBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);BEADS_LITE</DefineConstants>
    <OutputPath>bin\Current\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(LiteBuild)' == 'true'">
    <Compile Remove="Runtime\WorkshopMenu.cs;Runtime\EditorPanel.cs;Runtime\EditorJourney.cs;Runtime\SupplyPanel.cs;Runtime\ClothingPreview.cs;Runtime\LibraryPanel.cs;Runtime\ImportPanel.cs;Runtime\WeaponPanel.cs;Runtime\RefinementContent.cs;Runtime\MaterialPreparationService.cs" />
    <Compile Remove="Runtime\WorkshopService.cs;Runtime\ReferencePatternContent.cs;Runtime\PatternDetailMenu.cs;Data\WorkshopProgress.cs;Data\WorkshopGuidance.cs;Data\ReferencePatterns.cs;Data\ReferencePatternOverrides.cs;Data\ReferencePatternArt.g.cs;Data\PatternDetailLayout.cs" />
    <!-- Old-only editors, preparation flow, and UI layouts remain in source for maintenance but are not shipped. -->
    <Compile Remove="Runtime\DraftStatus.cs;Data\BeadPreparation.cs;Data\DraftRepairs.cs;Data\ImportLayout.cs;Data\MaterialPanelLayout.cs;Data\PickerLayout.cs;Data\TemplateConversion.cs;Data\WeaponDraftPreview.cs;Data\WeaponPanelLayout.cs;Data\WorkshopMenuLayout.cs;Data\WorkshopPages.cs" />
    <None Remove="assets\patterns\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="xTile"><HintPath>$(GamePath)\xTile.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GamePath)\StardewValley.GameData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\smapi-internal\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces"><HintPath>$(GamePath)\smapi-internal\SMAPI.Toolkit.CoreInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GamePath)\StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GamePath)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="i18n\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)\StardewModdingAPI.dll')" Text="找不到 SMAPI 引用，请通过 -p:GamePath 指定已安装 SMAPI 的游戏目录。" />
    <Error Condition="!Exists('$(GamePath)\Stardew Valley.dll')" Text="找不到星露谷游戏引用，请检查 GamePath。" />
    <Error Condition="!Exists('$(GamePath)\MonoGame.Framework.dll')" Text="找不到 MonoGame 引用，请检查游戏安装。" />
  </Target>
</Project>
