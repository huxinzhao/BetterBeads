  {
    "Key": "copy.WorkshopGuidance.70994f61d2",
    "Text": "春季首次完成委托",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 8
  },
  {
    "Key": "copy.WorkshopGuidance.375980e82c",
    "Text": "夏季首次完成委托",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 8
  },
  {
    "Key": "copy.WorkshopGuidance.a8e81634b7",
    "Text": "秋季首次完成委托",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 9
  },
  {
    "Key": "copy.WorkshopGuidance.972021ec66",
    "Text": "冬季首次完成委托",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 9
  },
  {
    "Key": "copy.WorkshopGuidance.aa358f4c84",
    "Text": "入门图纸",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 10
  },
  {
    "Key": "copy.WorkshopGuidance.9520f858c0",
    "Text": "酒馆想添一幅新芽或花束挂画，迎接春日的客人。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 15
  },
  {
    "Key": "copy.WorkshopGuidance.ec37c904d3",
    "Text": "格斯想用海浪、贝壳或水果图案给酒馆添点凉意。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 15
  },
  {
    "Key": "copy.WorkshopGuidance.be1d442aea",
    "Text": "格斯想用南瓜、落叶或丰收图案装点酒馆。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 15
  },
  {
    "Key": "copy.WorkshopGuidance.2d1624e06f",
    "Text": "格斯想用星灯、雪景或暖色挂画装点冬日酒馆。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 15
  },
  {
    "Key": "copy.WorkshopGuidance.d2cea8d80d",
    "Text": "艾米丽正在搭配春游装，花朵和嫩叶都是好灵感。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 16
  },
  {
    "Key": "copy.WorkshopGuidance.581d226c89",
    "Text": "艾米丽想尝试夏日穿搭，可以用海风或向日葵配色。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 16
  },
  {
    "Key": "copy.WorkshopGuidance.b3d29fd9a6",
    "Text": "艾米丽正在搭配秋装，补丁、落叶和暖色都很合适。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 16
  },
  {
    "Key": "copy.WorkshopGuidance.1845b2cc77",
    "Text": "艾米丽想设计冬日穿搭，可以尝试雪花或星光配色。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 16
  },
  {
    "Key": "copy.WorkshopGuidance.54ed104cd4",
    "Text": "罗宾想给春日小屋添一件手作，可以尝试花园或林木主题。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 17
  },
  {
    "Key": "copy.WorkshopGuidance.f92e9c6840",
    "Text": "罗宾想布置夏日休憩角，可以尝试海滨或清凉的绿叶主题。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 17
  },
  {
    "Key": "copy.WorkshopGuidance.04bc35bce3",
    "Text": "罗宾想布置收获季小屋，可以尝试南瓜、木纹或秋叶主题。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 17
  },
  {
    "Key": "copy.WorkshopGuidance.11160ff5aa",
    "Text": "罗宾想布置冬日小屋，可以尝试雪人、松枝或温暖灯火主题。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 17
  },
  {
    "Key": "copy.WorkshopGuidance.77a67a64ab",
    "Text": "主题仅供灵感，图案和配色由你决定。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 18
  },
  {
    "Key": "copy.WorkshopGuidance.7eea797f56",
    "Text": "制作固定消耗{0}颗羊毛豆（所有方向合计）；羊毛或布料可自动折算。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 34
  },
  {
    "Key": "copy.WorkshopGuidance.a617273f6e",
    "Text": "制作至少消耗{0}颗普通豆；按实际图案与结构预算中较高者计费。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 35
  },
  {
    "Key": "copy.WorkshopGuidance.c5c6c80378",
    "Text": "16格和32格画均可交付，精细画按实际豆数收费。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 36
  },
  {
    "Key": "copy.WorkshopGuidance.3c1e31a193",
    "Text": "金",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 43
  },
  {
    "Key": "copy.WorkshopGuidance.6305279d5c",
    "Text": "友好度",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 43
  },
  {
    "Key": "copy.WorkshopGuidance.207cd83136",
    "Text": "图纸：",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 47
  },
  {
    "Key": "copy.WorkshopGuidance.ea4f1d6156",
    "Text": "单特效槽",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 49
  },
  {
    "Key": "copy.WorkshopGuidance.e02e6e9a0b",
    "Text": "熔炉精炼",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 49
  },
  {
    "Key": "copy.WorkshopGuidance.fcbe6ab764",
    "Text": "双特效槽",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 49
  },
  {
    "Key": "copy.WorkshopGuidance.483b4c3034",
    "Text": "银河之魂强化",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 49
  },
  {
    "Key": "copy.WorkshopGuidance.e4d3ccb6bd",
    "Text": "工艺：",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 50
  },
  {
    "Key": "copy.WorkshopGuidance.5f7d6a1c5a",
    "Text": "每七日自动委托",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 51
  },
  {
    "Key": "copy.WorkshopGuidance.de4ff756af",
    "Text": "奖励：",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 52
  },
  {
    "Key": "copy.WorkshopGuidance.e23b1efff6",
    "Text": "当期委托已写入日志；明天留意艾米丽和克林特的来信。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 56
  },
  {
    "Key": "copy.WorkshopGuidance.a82a468b30",
    "Text": "后续刷新可能出现服装委托；现有委托保持不变。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 57
  },
  {
    "Key": "copy.WorkshopGuidance.69c425e14f",
    "Text": "现在可以为武器选择一种宝石特效；明天留意耐热试验来信。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 58
  },
  {
    "Key": "copy.WorkshopGuidance.0f3f2c01db",
    "Text": "在武器的更多菜单取豆，再用熔炉精炼；明天开始马龙的实战任务。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 59
  },
  {
    "Key": "copy.WorkshopGuidance.4be06764ef",
    "Text": "可尝试两种宝石搭配；银河之魂强化仍需取得原生稀有材料。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 60
  },
  {
    "Key": "copy.WorkshopGuidance.2dee012cc1",
    "Text": "本期委托已完成，下个七日周期自动刷新。新图纸可在参考图纸中复制。",
    "File": "BetterBeads/Data/WorkshopGuidance.cs",
    "Line": 61
  },
  {
    "Key": "copy.WorkshopProgress.777725ec2a",
    "Text": "第一件手作",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 103
  },
  {
    "Key": "copy.WorkshopProgress.f27727ce2b",
    "Text": "罗宾想为工坊添一幅拼豆画。交付一幅至少32颗豆的拼豆画；图案和配色由你决定。完成后开放每周委托，获得两张图纸。",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 103
  },
  {
    "Key": "copy.WorkshopProgress.1ce470add2",
    "Text": "把作品穿出去",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 104
  },
  {
    "Key": "copy.WorkshopProgress.77eb23335f",
    "Text": "艾米丽想看看你的穿搭。交付一顶四向完整、每向至少8颗豆的拼豆帽。完成后开放服装委托，获得两张图纸。",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 104
  },
  {
    "Key": "copy.WorkshopProgress.7cba4bfc85",
    "Text": "金属也能拼",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 105
  },
  {
    "Key": "copy.WorkshopProgress.bfc5cc0712",
    "Text": "向克林特展示一件铜、铁及其精炼豆合计至少占60%的拼豆武器。武器检测后归还。完成后开放一个特效槽，获得两张图纸。",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 105
  },
  {
    "Key": "copy.WorkshopProgress.66414afe62",
    "Text": "耐热试验",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 106
  },
  {
    "Key": "copy.WorkshopProgress.b4dfdb1f78",
    "Text": "克林特准备测试拼豆的耐热性。交付2铁锭和1煤炭，学习用熔炉精炼并获得两张图纸。",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 106
  },
  {
    "Key": "copy.WorkshopProgress.7c4f80c0b5",
    "Text": "真正派上用场",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 107
  },
  {
    "Key": "copy.WorkshopProgress.4e9bd301cd",
    "Text": "用非创造模式拼豆武器击败10只怪物，再向马龙报告。开启双特效与银河之魂强化，并获得两张图纸。",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 107
  },
  {
    "Key": "copy.WorkshopProgress.2d9993166d",
    "Text": "春日新芽",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 121
  },
  {
    "Key": "copy.WorkshopProgress.1039824c5a",
    "Text": "夏日海风",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 121
  },
  {
    "Key": "copy.WorkshopProgress.3d1710d2c9",
    "Text": "秋日收获",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 121
  },
  {
    "Key": "copy.WorkshopProgress.2b133801cf",
    "Text": "冬日星光",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
    "Line": 121
  },
  {
    "Key": "copy.WorkshopProgress.f93cb12e8e",
    "Text": " · 家居",
    "File": "BetterBeads/Data/WorkshopProgress.cs",
